# Copy to .env and fill in (do not commit .env)

# Active connection (or use DATABASE_URL instead of discrete fields)
PGHOST=192.168.1.141
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
# DATABASE_URL=postgresql://postgres:password@192.168.1.141:5432/postgres

# Named profiles (optional) — switch with PG_PROFILE=dev|qa
PG_PROFILE=dev
PG_DEV_HOST=192.168.1.141
PG_DEV_PORT=5432
PG_DEV_USER=postgres
PG_DEV_PASSWORD=
PG_DEV_DATABASE=postgres
PG_QA_HOST=192.168.1.131
PG_QA_PORT=5432
PG_QA_USER=postgres
PG_QA_PASSWORD=
PG_QA_DATABASE=postgres

# Safety
PG_ALLOW_WRITE=false
PG_QUERY_TIMEOUT_MS=30000
PG_MAX_ROWS=500
